{
  "name": "qloo-explorer",
  "private": true,
  "type": "module",
  "description": "Throwaway app that exercises every Qloo API endpoint and every qloo mcp tool, plus a small web playground.",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "probe:rest": "node probe-rest.mjs",
    "probe:mcp": "node probe-mcp.mjs",
    "probe": "node probe-rest.mjs && node probe-mcp.mjs",
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "@qloo/qloo-harness": "0.1.26"
  }
}
